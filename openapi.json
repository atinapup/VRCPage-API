  "info": {
    "title": "vrc.page API",
    "description": "The backend for vrc.page. Errors use RFC 9457 Problem Details (application/problem+json), and every response carries an X-Request-Id header.",
    "version": "1",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness and readiness probes for load balancers and uptime checks."
    },
    {
      "name": "auth",
      "description": "Sign-in, sessions and account settings, on Better Auth. The session cookie belongs to the website, which forwards it."
    },
    {
      "name": "pages",
      "description": "Public pages at vrc.page/<name>."
    },
    {
      "name": "me",
      "description": "The signed-in account's own pages and settings, for the dashboard."
    },
    {
      "name": "dev",
      "description": "Development only: test-data shortcuts. Not registered in production."
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "Providers": {
        "type": "object",
        "properties": {
          "discord": {
            "type": "boolean"
          },
          "github": {
            "type": "boolean"
          }
        },
        "required": [
          "discord",
          "github"
        ]
      },
      "SignInCodeRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The address to send the code to."
          },
          "botCheckToken": {
            "type": "string",
            "description": "The Turnstile token from the sign-in form's widget."
          }
        },
        "required": [
          "email",
          "botCheckToken"
        ]
      },
      "PendingSignIn": {
        "type": "object",
        "properties": {
          "pendingToken": {
            "type": "string",
            "description": "The address, dated when its code went out and signed:\n`<sent at ms>.<signature>.<email>`. Keep it (the website uses an httpOnly\ncookie) and hand it back to resend without another bot check. Valid as\nlong as the code."
          },
          "sent": {
            "type": "boolean",
            "description": "False inside the resend cooldown: the code sent moments ago still stands."
          },
          "resendIn": {
            "type": "number",
            "description": "Seconds before another code can be sent."
          }
        },
        "required": [
          "pendingToken",
          "sent",
          "resendIn"
        ]
      },
      "ResendSignInCodeRequest": {
        "type": "object",
        "properties": {
          "pendingToken": {
            "type": "string"
          }
        },
        "required": [
          "pendingToken"
        ]
      },
      "SignInRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "The digits from the email; anything else in it is ignored."
          }
        },
        "required": [
          "email",
          "code"
        ]
      },
      "SocialSignInRequest": {
        "type": "object",
        "properties": {
          "callbackURL": {
            "type": "string",
            "description": "A path on the website, such as /dashboard."
          },
          "errorCallbackURL": {
            "type": "string",
            "description": "A path on the website; the provider's `error` is added to its query."
          }
        },
        "required": [
          "callbackURL",
