# Copy to .env and fill in. Never commit .env.
# Every URL points at your existing Postgres server. Add ?sslmode=disable if it has no TLS.

# A server admin (superuser) connection. Used only by `npm run db:bootstrap`
# (creates the roles and the database) and `npm run db:test`.
ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME@db.example.lan:5432/postgres

# Which database bootstrap/test work on. Use a throwaway name such as
# vrcpage_verify to try everything first, then switch to vrcpage.
VRCPAGE_DATABASE=vrcpage

# Passwords bootstrap gives the login roles. Re-running bootstrap resets them.
VRCPAGE_MIGRATOR_PASSWORD=
VRCPAGE_API_PASSWORD=
VRCPAGE_AUTH_PASSWORD=
VRCPAGE_MAINTENANCE_PASSWORD=
VRCPAGE_READONLY_PASSWORD=

# dbmate reads DATABASE_URL. The migrator acts as vrcpage_owner.
DATABASE_URL=postgres://vrcpage_migrator:CHANGE_ME@db.example.lan:5432/vrcpage

# Used by the API (later) and `npm run db:maintain`.
API_DATABASE_URL=postgres://vrcpage_api:CHANGE_ME@db.example.lan:5432/vrcpage
AUTH_DATABASE_URL=postgres://vrcpage_auth:CHANGE_ME@db.example.lan:5432/vrcpage
MAINTENANCE_DATABASE_URL=postgres://vrcpage_maintenance:CHANGE_ME@db.example.lan:5432/vrcpage
READONLY_DATABASE_URL=postgres://vrcpage_readonly:CHANGE_ME@db.example.lan:5432/vrcpage
