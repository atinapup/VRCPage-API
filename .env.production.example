# =============================================================================
#  vrc.page API: PRODUCTION environment
#  Copy to .env.production and fill in the blanks. Never commit it.
#  Used by: npm run db:bootstrap:prod, db:migrate:prod, db:status:prod, db:maintain:prod
#  Use passwords that differ from development.
# =============================================================================


# -----------------------------------------------------------------------------
#  API server (NODE_ENV=production npm start)
# -----------------------------------------------------------------------------

PORT=4000
# The website's address; the only origin allowed to call the API from a browser.
WEB_ORIGIN=https://vrc.page


# -----------------------------------------------------------------------------
#  Database server
# -----------------------------------------------------------------------------

DB_HOST=192.168.0.4
DB_PORT=5432
DB_NAME=vrcpage
DB_SSL_MODE=disable


# -----------------------------------------------------------------------------
#  Admin login: a superuser on your server
#  Only used by db:bootstrap:prod. The API never uses it; remove it from the
#  production server's copy of this file once set up.
# -----------------------------------------------------------------------------

DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=
DB_ADMIN_DATABASE=postgres


# -----------------------------------------------------------------------------
#  Production logins
#  bootstrap creates each one with this password (re-running resets them).
#  These can only open the production database.
#  The permissions come from the role in brackets.
# -----------------------------------------------------------------------------

# Migrations. Acts as the owner of every table.                         [vrcpage_owner]
DB_MIGRATOR_USER=vrcpage_prod_migrator
DB_MIGRATOR_PASSWORD=

# The API: reads and writes vrc.page's data, within the locks.          [vrcpage_api]
DB_API_USER=vrcpage_prod_api
DB_API_PASSWORD=

# Better Auth: sign-in tables only.                                      [vrcpage_auth]
DB_AUTH_USER=vrcpage_prod_auth
DB_AUTH_PASSWORD=

# Nightly maintenance: cleanup and partitions.                           [vrcpage_maintenance]
DB_MAINTENANCE_USER=vrcpage_prod_maintenance
DB_MAINTENANCE_PASSWORD=

# Read-only: for browsing in a SQL tool. Cannot see tokens or passwords. [vrcpage_readonly]
DB_READONLY_USER=vrcpage_prod_readonly
DB_READONLY_PASSWORD=

# -----------------------------------------------------------------------------
#  Sign-in (Better Auth runs here; the website proxies /api/auth/* to it)
# -----------------------------------------------------------------------------

# Signs sessions, OAuth state and pending sign-in tokens. At least 32 random
# characters, e.g. node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# OAuth apps. Leave a pair empty to leave that provider out. The callback URL
# registered with each is the WEBSITE's: <WEB_ORIGIN>/api/auth/callback/discord
# and <WEB_ORIGIN>/api/auth/callback/github.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare Turnstile secret; the site key goes in the website's env.
# Required: without it every sign-in code is refused.
TURNSTILE_SECRET_KEY=

# Run without an email sender, printing codes to the log instead. Only for
# testing a LOCAL production build; on a deployed server, set RESEND_API_KEY.
VRCPAGE_PRINT_SIGN_IN_CODES=false

# -----------------------------------------------------------------------------
#  Email (Resend)
# -----------------------------------------------------------------------------

# Required. Resend's API key (re_...). Without it the API refuses to start,
# because nobody could sign in.
RESEND_API_KEY=

# The From address. Its domain has to be verified in Resend, with SPF, DKIM and
# DMARC records, or mail lands in spam.
MAIL_FROM="vrc.page <hello@vrc.page>"

# Where replies go. Empty means replies go back to MAIL_FROM.
MAIL_REPLY_TO=

# Resend's webhook signing secret (whsec_...), from the endpoint you add at
# <this API>/v1/webhooks/resend. Without it every webhook is refused, so
# bounces and spam complaints are never learned about.
RESEND_WEBHOOK_SECRET=
